// ---------------------------------------------------------------------------
// Laravel Echo bootstrap — the realtime transport for the Notification Platform.
//
// Echo + the pusher-protocol client are LAZY-loaded, and ONLY when a broadcaster
// key is present at build time: VITE_REVERB_APP_KEY (Reverb, self-hosted) or
// VITE_PUSHER_APP_KEY (Pusher / compatible). With broadcast turned off no key is
// set, the socket is never opened, and window.Echo stays undefined — so realtime.js
// is inert and the bell behaves exactly as it did before broadcast existed.
//
// This module only opens the socket + exposes window.Echo; it knows nothing about
// notifications. realtime.js does the subscribing. The persisted Notification
// store is the source of truth — the socket is a best-effort nudge, never the
// system of record (see realtime.js).
// ---------------------------------------------------------------------------
const reverbKey = import.meta.env.VITE_REVERB_APP_KEY;
const pusherKey = import.meta.env.VITE_PUSHER_APP_KEY;

if (reverbKey || pusherKey) {
    Promise.all([import('laravel-echo'), import('pusher-js')]).then(([{ default: Echo }, { default: Pusher }]) => {
        window.Pusher = Pusher; // both the 'reverb' and 'pusher' broadcasters use the pusher-js client

        window.Echo = reverbKey
            ? new Echo({
                broadcaster: 'reverb',
                key: reverbKey,
                wsHost: import.meta.env.VITE_REVERB_HOST ?? window.location.hostname,
                wsPort: Number(import.meta.env.VITE_REVERB_PORT ?? 8080),
                wssPort: Number(import.meta.env.VITE_REVERB_PORT ?? 443),
                forceTLS: (import.meta.env.VITE_REVERB_SCHEME ?? 'https') === 'https',
                enabledTransports: ['ws', 'wss'],
            })
            : new Echo({
                broadcaster: 'pusher',
                key: pusherKey,
                cluster: import.meta.env.VITE_PUSHER_APP_CLUSTER ?? 'mt1',
                forceTLS: true,
            });

        // realtime.js may have evaluated before this async import resolved — tell it the socket is live.
        window.dispatchEvent(new Event('ac:echo:ready'));
    });
}
