<?php

namespace App\Services\Roles;

use App\Models\Role;
use App\Services\Permissions\PermissionService;
use Illuminate\Database\Eloquent\Model;
use Ngos\AdminCore\Services\BaseService;
use Ngos\AdminCore\Services\Concerns\GrantsWithinOwnAuthority;

class RoleService extends BaseService
{
    use GrantsWithinOwnAuthority;

    private PermissionService $permissionService;

    public function __construct(Role $role, PermissionService $permissionService)
    {
        $this->model = $role;
        $this->permissionService = $permissionService;
    }

    public function create(array $data): Model
    {
        $permissions = $data['permissions'] ?? [];
        unset($data['permissions']);
        $data['guard_name'] = $data['guard_name'] ?? 'web';

        // Least-privilege: the editor may only grant permissions they hold themselves — otherwise
        // `edit-role` alone is a self-service escalation (sync every permission onto your own role).
        $granted = $this->permissionService->query()->whereIn('id', $permissions)->get();
        $this->assertCanGrantPermissions($granted, []);

        $role = $this->model->create($data);
        $role->syncPermissions($granted);

        return $role;
    }

    public function update(int|string $id, array $data): Model
    {
        $permissions = $data['permissions'] ?? [];
        unset($data['permissions']);

        $role = $this->find($id);
        // Only newly ADDED permissions are checked, so editing the name (resubmitting current grants) is fine.
        $granted = $this->permissionService->query()->whereIn('id', $permissions)->get();
        $this->assertCanGrantPermissions($granted, $role->permissions->pluck('id'));

        $role->update($data);
        $role->syncPermissions($granted);

        return $role;
    }
}
