<?php

namespace App\Services\Users;

use App\Models\User;
use App\Services\Roles\RoleService;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Support\Facades\Hash;
use Ngos\AdminCore\Services\BaseService;
use Ngos\AdminCore\Services\Concerns\GrantsWithinOwnAuthority;

class UserService extends BaseService
{
    use GrantsWithinOwnAuthority;

    private RoleService $roleService;

    public function __construct(User $user, RoleService $roleService)
    {
        $this->model = $user;
        $this->roleService = $roleService;
    }

    public function create(array $data): Model
    {
        $roles = $data['roles'] ?? [];
        unset($data['roles']);
        $data['password'] = Hash::make($data['password']);

        // Least-privilege: the editor may only assign roles within their own authority — otherwise
        // `edit-user` alone lets an account hand itself the super role (self-service escalation).
        $assigned = $this->roleService->query()->whereIn('id', $roles)->get();
        $this->assertCanGrantRoles($assigned, []);

        $user = $this->model->create($data);
        $user->syncRoles($assigned);

        return $user;
    }

    public function update(int|string $id, array $data): Model
    {
        $roles = $data['roles'] ?? [];
        unset($data['roles']);
        if (empty($data['password'])) {
            unset($data['password']);
        } else {
            $data['password'] = Hash::make($data['password']);
        }

        $user = $this->find($id);
        // Refuse editing a user who OUTRANKS the actor — otherwise `edit-user` alone overwrites a super-admin's
        // email/password (a full account takeover). Checked BEFORE any write and before the role grant check.
        $this->assertCanEditTarget($user);
        // Only newly ADDED roles are checked, so editing the name/email (resubmitting current roles) is fine.
        $assigned = $this->roleService->query()->whereIn('id', $roles)->get();
        $this->assertCanGrantRoles($assigned, $user->roles->pluck('id'));

        $user->update($data);
        $user->syncRoles($assigned);

        return $user;
    }

    public function delete(int|string $id): void
    {
        $user = $this->find($id);
        // A non-super actor must not delete a user who outranks them (locking out a super-admin).
        $this->assertCanEditTarget($user);
        $user->delete();
    }
}
